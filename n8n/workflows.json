  {
    "id": "RevAIabandonChk1",
    "name": "AI Revenue Recovery - Abandonment Check",
    "active": false,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 15
              }
            ]
          }
        },
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          -400,
          0
        ],
        "id": "0a149313-6206-4a62-999e-7323572df56c",
        "name": "Every 15 minutes"
      },
      {
        "parameters": {
          "operation": "getAll",
          "tableId": "carts",
          "returnAll": true,
          "filterType": "string",
          "filterString": "=status=eq.active&updated_at=lt.{{ $now.toUTC().minus({ minutes: 30 }).toFormat(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") }}"
        },
        "type": "n8n-nodes-base.supabase",
        "typeVersion": 1,
        "position": [
          -150,
          0
        ],
        "id": "0739f041-b07a-46c8-99c6-4cd7fddbf453",
        "name": "Find stale active carts",
        "credentials": {
          "supabaseApi": {
            "id": "c613UBpyTuAZWHmG",
            "name": "Supabase account"
          }
        }
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:5000/api/webhooks/cart-abandoned",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"cartId\": \"{{ $json.id }}\" }",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          100,
          0
        ],
        "id": "12c1cb97-1a51-4946-b379-cc7c8e5a07f7",
        "name": "Mark cart abandoned",
        "credentials": {
          "httpHeaderAuth": {
            "id": "RevAIbackendHdr1",
            "name": "ReviveAI backend"
          }
        }
      }
    ],
    "connections": {
      "Every 15 minutes": {
        "main": [
          [
            {
              "node": "Find stale active carts",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Find stale active carts": {
        "main": [
          [
            {
              "node": "Mark cart abandoned",
              "type": "main",
              "index": 0
            }
          ]
        ]
