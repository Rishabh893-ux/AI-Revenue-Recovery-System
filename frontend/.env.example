# Backend API base URL — never hardcode this elsewhere in the app.
VITE_API_URL=http://localhost:5000/api

# Public Supabase project values ONLY. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay PUBLIC key id only (starts with rzp_). The secret key belongs on
# the backend, never in this file or anywhere in the frontend.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
