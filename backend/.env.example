PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Razorpay — from the Razorpay dashboard. Secret and webhook secret NEVER
# go in the frontend.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
# A long random string; must match the secret set on the webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# Supabase — service_role key, full access. NEVER expose this to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n webhook URLs this backend notifies on cart/payment events (optional —
# routes still work without these, just log a warning and skip the ping).
N8N_ABANDONED_CART_WEBHOOK=http://localhost:5678/webhook/abandoned-cart
N8N_FAILED_PAYMENT_WEBHOOK=http://localhost:5678/webhook/failed-payment

# Shared secret n8n (or your abandonment cron job) must send in the
# x-n8n-secret header when calling POST /api/webhooks/cart-abandoned or
# POST /api/webhooks/n8n/recovery-action. Use a long random string, NOT a URL:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_SHARED_SECRET=
